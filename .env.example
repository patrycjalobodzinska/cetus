# Sanity (CMS) - identyfikatory projektu i dataset są publiczne, token nie.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Adres produkcyjny - używany w metadanych, sitemapie i robots.txt.
NEXT_PUBLIC_SITE_URL=https://cetuspro.com

# Microsoft Clarity - identyfikator projektu. Skrypt wczytuje się WYŁĄCZNIE po
# zgodzie użytkownika na analitykę (patrz app/components/consent/). Brak
# zmiennej = brak analityki, więc lokalnie i na preview można ją pominąć.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Srodowisko. "staging" pokazuje wszystkie sekcje ukryte na produkcji
# (Realizacje, O nas, galeria zespolu) - taki build stawiamy z GitHuba.
# Produkcja (GitLab) zostawia te zmienna pusta, wiec ukryte zostaje ukryte.
NEXT_PUBLIC_SITE_STAGE=

# Pojedyncze sekcje mozna odslonic takze na produkcji, bez zmiany kodu: "1".
NEXT_PUBLIC_SHOW_CASE_STUDIES=
NEXT_PUBLIC_SHOW_ABOUT_PAGE=
NEXT_PUBLIC_SHOW_TEAM_GALLERY=
